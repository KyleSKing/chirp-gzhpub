# WeChat Official Account credentials
# Get these from https://mp.weixin.qq.com → 开发 → 基本配置
WECHAT_APP_ID=your_app_id_here
WECHAT_APP_SECRET=your_app_secret_here

# Default author shown in drafts (can be overridden by frontmatter `wechat_author`)
WECHAT_AUTHOR=AI安全情报

# Optional: base URL for the source article in `content_source_url`
# When unset, the field is left empty in the draft.
SITE_URL=https://kylesking.github.io/ai-infosec-landing
